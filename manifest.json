{
  "manifest_version": 3,
  "name": "Pencil Guard",
  "version": "1.0.1",
  "description": "Smarter pencil marks for sudoku.coach: auto-eliminates candidates for Anti-Knight, Anti-King and Nonconsecutive rules, and warns when you remove a correct candidate.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://sudoku.coach/*",
    "*://*.sudoku.coach/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://sudoku.coach/*",
        "*://*.sudoku.coach/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Pencil Guard",
    "default_popup": "popup.html"
  }
}
